# VITAL Environment Configuration Example

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=vital

# Authentication / Security
JWT_SECRET_KEY=change_this_to_a_secure_random_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Geofence Settings (Default Classroom / Lab Coordinates)
DEFAULT_CAMPUS_LAT=22.5726
DEFAULT_CAMPUS_LON=88.3639
DEFAULT_ALLOWED_RADIUS_METERS=100.0

# Attendance & Face Recognition Settings
FACE_SIMILARITY_THRESHOLD=0.40
ATTENDANCE_SESSION_DURATION_SECONDS=300
